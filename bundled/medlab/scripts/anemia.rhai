// Ориентировочная степень тяжести уже установленной анемии по Hb, г/л.
// Порог наличия анемии зависит от пола, возраста и беременности.

fn calculate(input) {
    let hb = parse_int(input);

    if hb <= 0 || hb > 250 {
        return "Анемия: проверьте значение Hb";
    }

    if hb < 70 {
        `Анемия тяжёлой степени (Hb ${hb} г/л от ...)`
    } else if hb <= 90 {
        `Анемия средней степени тяжести (Hb ${hb} г/л от ...)`
    } else if hb <= 110 {
        `Анемия лёгкой степени тяжести (Hb ${hb} г/л от ...)`
    } else {
        `Степень анемии по Hb не определяется (Hb ${hb} г/л); наличие анемии оцените с учётом пола, возраста и беременности.`
    }
}
